{
    "name": "pashamesh/uiscom-api-client",
    "description": "PHP binding for UIScom (formerly CoMagic) API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "uis",
        "uiscom",
        "comagic",
        "sdk",
        "php",
        "api",
        "package",
        "uiscom sdk",
        "uiscom api",
        "uiscom dataapi",
        "uiscom callapi",
        "uiscom package"
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.2|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Uiscom\\": "src/Uiscom/"
        }
    },
    "authors": [
        {
            "name": "Pasha Mesh",
            "email": "pasha.mesh@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "^3.89",
        "symfony/var-dumper": "^5.4 || ^6.4 || ^7.3 || ^8.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2"
    },
    "scripts": {
        "all": [
            "@rector",
            "@format",
            "@analyse",
            "@test"
        ],
        "analyse": "./vendor/bin/phpstan analyse",
        "format": "./vendor/bin/php-cs-fixer fix",
        "rector": "vendor/bin/rector process --dry-run",
        "test": "./vendor/bin/phpunit tests"
    },
    "config": {
        "platform": {
            "php": "7.4.1"
        }
    }
}
